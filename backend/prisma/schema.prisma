generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  REVIEWER
  UNIT
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssessmentAnswerSource {
  SATKER
  PENILAI
}

model Satker {
  id          Int       @id @default(autoincrement())
  nama_satker String
  users       User[]
  inovasi     Inovasi[]
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  nama_lengkap      String
  no_hp             String?
  role              Role
  status_registrasi RegistrationStatus @default(PENDING)
  satker_id         Int?
  satker            Satker?            @relation(fields: [satker_id], references: [id])

  // 1. Inovasi yang DIBUAT oleh user ini
  inovasi           Inovasi[]          @relation("PembuatInovasi")

  // 2. TAMBAHAN: Inovasi yang DINILAI oleh user ini
  inovasi_dinilai   Inovasi[]          @relation("PenugasanInovasi")
  inovasi_dinilai_tahap2 Inovasi[] @relation("PenugasanInovasiTahap2")

  // 3. TAMBAHAN: Tanda tangan usulan ini
  usulan_signatures UsulinSignature[]
}

enum StatusInovasi {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PERBAIKAN
  SELESAI_EVALUASI
}

model Inovasi {
  id                    Int                @id @default(autoincrement())
  judul                 String
  deskripsi_inovasi    String?
  tahun                 Int
  jenis_inovasi         String
    jenis_inovasi_pilihan String[]           @default([])
  jenis_inovasi_lainnya String?
  kriteria_inovasi      String[]
  link_data_dukung      String
  pic_nama              String
  pic_telp              String
  pic_penanggung_jawab  Json?
  status                StatusInovasi      @default(PENDING)
  satker_id             Int
  satker                Satker             @relation(fields: [satker_id], references: [id])

  // 1. Relasi ke pembuat inovasi (User)
  user_id               Int
  user                  User               @relation("PembuatInovasi", fields: [user_id], references: [id])

  // 2. TAMBAHAN: Relasi ke penilai inovasi (User - Many to Many)
  penilai               User[]             @relation("PenugasanInovasi")
  penilai_tahap2 User[] @relation("PenugasanInovasiTahap2")
  status_tahap2 StatusInovasi @default(PENDING)

  // 3. TAMBAHAN: Relasi ke tanda tangan usulan
  usulan_signatures     UsulinSignature[]

  catatan_perbaikan     String?

  ski_nama              String?
  ski_nip               String?
  ski_signed_at         DateTime?
  ski_ttd_image         String?
  timker_nama           String?
  timker_nip            String?
  timker_signed_at      DateTime?
  timker_ttd_image      String?

  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt
  assessment_answers    AssessmentAnswer[]
  template_package_id   Int?
  template_package      AssessmentTemplatePackage? @relation(fields: [template_package_id], references: [id], onDelete: Restrict)
  workflow              Json?
}

model AssessmentQuestion {
  tahap Int @default(1)
  id         Int                @id @default(autoincrement())
  satker_lock_mode String @default("NONE")
  pertanyaan String
  is_header Boolean @default(false)
  urutan Int @default(0)
  question_title_override String?
  column_titles Json?
  is_active  Boolean            @default(true)
  tahap2_hidden Boolean @default(false)
  parent_id  Int?
  parent     AssessmentQuestion? @relation("SubQuestions", fields: [parent_id], references: [id], onDelete: Cascade)
  children   AssessmentQuestion[] @relation("SubQuestions")
  answers    AssessmentAnswer[]
}

model AssessmentAnswer {
  custom_values Json?
  tahap Int @default(1)
  source AssessmentAnswerSource @default(SATKER)
  id              Int                @id @default(autoincrement())
  inovasi_id      Int
  inovasi         Inovasi            @relation(fields: [inovasi_id], references: [id], onDelete: Cascade)
  question_id     Int
  question        AssessmentQuestion @relation(fields: [question_id], references: [id])
  jawaban_boolean Boolean
  catatan_string  String?
  link            String?

  @@index([inovasi_id, tahap, source])
}

model AssessmentTemplatePackage {
  id           Int       @id @default(autoincrement())
  nama         String
  config       Json
  published_at DateTime?
  used_at      DateTime?
  created_at   DateTime  @default(now())
  inovasi      Inovasi[]
}

model UsulinSignature {
  keputusan   String?
  tahap Int @default(1)
  id          Int       @id @default(autoincrement())
  usulan_id   Int
  user_id     Int
  role        String
  nama        String
  nip         String
  jabatan     String
  ttd_image   String?
  created_at  DateTime  @default(now())

  usulan      Inovasi   @relation(fields: [usulan_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id])
}
