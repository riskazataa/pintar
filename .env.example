# Konfigurasi Docker Compose; salin menjadi .env di root repository.
FRONTEND_URL=https://siapin.dikalaksana.com
API_URL=https://api-siapin.dikalaksana.com
# Network existing yang sudah terhubung ke container nginx VPS.
PROXY_NETWORK=manris_manris-network

# Isi masing-masing dengan hasil berbeda dari: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# API key Resend dan alamat pengirim dari domain terverifikasi di Resend.
RESEND_API_KEY=
EMAIL_FROM=SIAPIN <noreply@domain-anda.id>
